---
classes:
 - quire-cover
description: Quire publication cover page
layout: base.11ty.js
## CUSTOMIZED FILE
## Added image paths for quadrisected cover image layers in place of default, lines 12~40
---

{% assign coverImage = image %}
{% assign imagePath = config.figures.imageDir | concat: coverImage | join: '/' %}

<section class="quire-cover__hero hero is-fullheight">
  <div class="quire-cover__overlay">
    
    <section class="quire-cover__hero hero is-fullheight">
    <div class="quire-cover__overlay upper-left">
    <img src="./_assets/images/upper-left/portrait.jpg">
    <img src="./_assets/images/upper-left/portrait-uv.jpg">
    <img src="./_assets/images/upper-left/portrait-xray.jpg">
    <img src="./_assets/images/upper-left/portrait-ir.jpg">
    </div>
    <div class="quire-cover__overlay upper-right">
    <img src="./_assets/images/upper-right/portrait.jpg">
    <img src="./_assets/images/upper-right/portrait-uv.jpg">
    <img src="./_assets/images/upper-right/portrait-xray.jpg">
    <img src="./_assets/images/upper-right/portrait-ir.jpg">
    </div>
    <div class="quire-cover__overlay lower-left">
    <img src="./_assets/images/lower-left/portrait.jpg">
    <img src="./_assets/images/lower-left/portrait-uv.jpg">
    <img src="./_assets/images/lower-left/portrait-xray.jpg">
    <img src="./_assets/images/lower-left/portrait-ir.jpg">
    </div>
    <div class="quire-cover__overlay lower-right">
    <img src="./_assets/images/lower-right/portrait.jpg">
    <img src="./_assets/images/lower-right/portrait-uv.jpg">
    <img src="./_assets/images/lower-right/portrait-xray.jpg">
    <img src="./_assets/images/lower-right/portrait-ir.jpg">
    </div>
</section>

    <!-- This ensures background image asset gets copied into epub package -->
    <img class="visually-hidden" src="{{ imagePath }}" />
  </div>
  <div class="quire-cover__hero-body hero-body">
    <div class="container is-fluid">
      <h1 class="title" id="page-header-{{ page.filePathStem }}">
        {{ publication.title | markdownify }}
        {% if publication.subtitle %}
          <span class="visually-hidden">: </span>
          <span class="subtitle">{{ publication.subtitle | markdownify }}</span>
        {% endif %}
      </h1>
      <p class="reading-line">{{ publication.reading_line | markdownify }}</p>
      <div class="contributor">
        <span class="visually-hidden">Contributors: </span>
        {% if publication.contributor_as_it_appears %}
          <em>{{ publication.contributor_as_it_appears }}</em>
        {% else %}
          <em>{% contributors context=publicationContributors, format='string', type='primary' %}</em>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% if content != blank %}
  <section class="quire-cover__more next-page">
    <div class="quire-cover__more-body hero-more">
      <a href="#cover-content">
        {% icon type='down-arrow', description='Scroll down to read more' %}
      </a>
    </div>
  </section>

  <section id="cover-content" class="section quire-page__content">
    <div class="container is-fluid">
      <div class="content">
        {{ content }}
        {% bibliography citations %}
      </div>
    </div>
  </section>

  {% pageButtons pagination=pagination %}

{% else %}
  <section class="quire-cover__more">
    <div class="quire-cover__more-body hero-more next-page">
      <a href="{{ pagination.nextPage.url }}">
        {% icon type='down-arrow', description='Scroll down to read more' %}
      </a>
    </div>
  </section>
{% endif %}
